# Server Configuration
PORT=3000
NODE_ENV=development

# Google Geocoding API
# Get your API key from: https://console.cloud.google.com/
# Enable "Geocoding API" in your Google Cloud project
GOOGLE_GEOCODING_API_KEY=your_google_api_key_here
# Google Geocoding API base URL (optional, defaults to official Google API endpoint)
GOOGLE_GEOCODING_API_URL=https://maps.googleapis.com/maps/api/geocode/json

# Redis Configuration
# Leave REDIS_HOST empty to use in-memory cache (default)
# Set REDIS_HOST to use Redis for distributed caching
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TTL=3600

# Rate Limiting Configuration
# TTL: Time window in seconds
# MAX: Maximum requests per time window
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS Configuration
# Comma-separated list of allowed origins, or "*" for all origins
# Example: http://localhost:3000,https://example.com
CORS_ORIGIN=*
# Whether to allow credentials in CORS requests (true/false)
CORS_CREDENTIALS=false
# Comma-separated list of allowed HTTP methods
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
# Comma-separated list of allowed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Logging Configuration
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Log format: json (for production/log aggregation) or pretty (for development)
LOG_FORMAT=json

# Circuit Breaker Configuration
# Error threshold percentage to open circuit (0-100)
# When this percentage of requests fail, the circuit opens
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
# Timeout in milliseconds for API calls
CIRCUIT_BREAKER_TIMEOUT=10000
# Time in milliseconds before attempting to close circuit after opening
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
# Time window in milliseconds for error rate calculation
CIRCUIT_BREAKER_ROLLING_WINDOW=10000
